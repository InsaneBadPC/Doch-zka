rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'insanebad2@gmail.com' ||
        request.auth.token.email == 'admin@firma.cz' ||
        request.auth.token.email == 'marek.dubina@dochazka.cz'
      );
    }

    // Kolekce users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isBootstrappedAdmin());
      allow delete: if isBootstrappedAdmin();
    }

    // Kolekce projects
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Kolekce time_entries
    match /time_entries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Kolekce fotodokumentace k zakázkám
    match /project_photos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Kolekce nepřítomností a kalendáře
    match /absences/{absenceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
