{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, default hourly rate and account active state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["worker", "admin"] },
        "defaultHourlyRate": { "type": "number" },
        "allowCustomRate": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role", "defaultHourlyRate", "active"]
    },
    "Project": {
      "title": "Project",
      "description": "Company construction, maintenance, or client project with budget limit and photo documentation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "client": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "budgetLimitKcz": { "type": "number" },
        "photos": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "client", "status", "budgetLimitKcz"]
    },
    "TimeEntry": {
      "title": "TimeEntry",
      "description": "Attendance shift record with timestamps, hours worked, hourly rate, and approval status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "breakMinutes": { "type": "number" },
        "hoursWorked": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "isCustomRate": { "type": "boolean" },
        "totalAmount": { "type": "number" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected"] },
        "isRunning": { "type": "boolean" },
        "adminComment": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "startLocation": { "type": "object" },
        "endLocation": { "type": "object" }
      },
      "required": ["userId", "userName", "projectId", "date", "startTime", "hourlyRate", "status"]
    },
    "ProjectPhoto": {
      "title": "ProjectPhoto",
      "description": "Project documentation photos uploaded by boss or workers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "photoData": { "type": "string" },
        "caption": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["projectId", "userId", "photoData"]
    },
    "Absence": {
      "title": "Absence",
      "description": "Employee planned leave, vacation, doctor visit or sick leave calendar entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["vacation", "doctor", "sick", "personal"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "isFullDay": { "type": "boolean" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "required": ["userId", "userName", "type", "startDate", "endDate", "isFullDay", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Uživatelské profily pracovníků a administrátorů"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Zakázky a evidence mzdových rozpočtů"
    },
    "/time_entries/{entryId}": {
      "schema": "TimeEntry",
      "description": "Záznamy směn a docházky"
    },
    "/project_photos/{photoId}": {
      "schema": "ProjectPhoto",
      "description": "Fotodokumentace k zakázkám"
    },
    "/absences/{absenceId}": {
      "schema": "Absence",
      "description": "Plánované nepřítomnosti, dovolené a lékaři"
    }
  }
}
