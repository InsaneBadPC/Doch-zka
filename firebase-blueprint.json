{
  "entities": {
    "User": {
      "title": "User",
      "description": "Systémový uživatel - pracovník nebo administrátor",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "enum": ["worker", "admin"] },
        "defaultHourlyRate": { "type": "number" },
        "allowCustomRate": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "email", "role", "defaultHourlyRate", "allowCustomRate", "active"]
    },
    "Project": {
      "title": "Project",
      "description": "Firemní zakázka s rozpočtem",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "client": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "budgetLimitKcz": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "client", "status", "budgetLimitKcz", "createdAt"]
    },
    "TimeEntry": {
      "title": "TimeEntry",
      "description": "Záznam odpracované směny na zakázce",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string" },
        "breakMinutes": { "type": "number" },
        "hoursWorked": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "isCustomRate": { "type": "boolean" },
        "totalAmount": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected"] },
        "isRunning": { "type": "boolean" },
        "adminComment": { "type": "string", "maxLength": 500 },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" }
      },
      "required": [
        "userId",
        "userName",
        "projectId",
        "projectName",
        "date",
        "startTime",
        "breakMinutes",
        "hoursWorked",
        "hourlyRate",
        "isCustomRate",
        "totalAmount",
        "note",
        "status",
        "isRunning"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities/User" },
      "description": "Profily uživatelů"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "entities/Project" },
      "description": "Zakázky a rozpočty"
    },
    "/time_entries/{entryId}": {
      "schema": { "$ref": "entities/TimeEntry" },
      "description": "Záznamy docházky a směn"
    }
  }
}
